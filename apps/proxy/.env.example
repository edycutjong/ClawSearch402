# ClawSearch 402 — Proxy Server Environment
# Copy to .env and fill in your values

# Stellar testnet address to receive payments
PAY_TO=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# x402 facilitator URL (Coinbase managed testnet)
FACILITATOR_URL=https://x402.org/facilitator

# Port for the proxy server
PORT=3001

# Search provider (searxng or brave)
SEARCH_PROVIDER=searxng

# SearXNG instance URL (public or self-hosted)
SEARXNG_URL=https://searx.be

# Brave Search API key (optional fallback)
BRAVE_API_KEY=

# Dashboard URL for CORS
DASHBOARD_URL=http://localhost:3000
