# ClawSearch 402 — Agent Client Environment
# Copy to .env and fill in your values

# Your Stellar testnet secret key (starts with S...)
# Auto-generated via: `node clients/node/fund.js`
# OR Generate manually at: https://laboratory.stellar.org/#account-creator
STELLAR_PRIVATE_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ClawSearch proxy URL
PROXY_URL=http://localhost:3001
