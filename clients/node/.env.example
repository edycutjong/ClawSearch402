# ClawSearch 402 — Agent Client Environment
# Copy to .env and fill in your values

# Your Stellar testnet secret key (starts with S...)
# Auto-generated via: `node clients/node/fund.js`
# OR Generate manually at: https://laboratory.stellar.org/#account-creator
STELLAR_PRIVATE_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ClawSearch proxy URL
PROXY_URL=http://localhost:3001

# The core sponsor account that distributes USDC to auto-generated clients
# 
# How to get a pre-funded testnet key:
# 1. Generate a Keypair & get XLM: https://laboratory.stellar.org/#account-creator?network=test
#    (Click "Generate keypair", then click "Fund with Friendbot" for XLM)
# 2. Get Testnet USDC: https://faucet.circle.com/
#    (Select "Stellar", paste your generated Public "G..." Key)
# 3. Paste the Secret "S..." Key below:
SPONSOR_PRIVATE_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
